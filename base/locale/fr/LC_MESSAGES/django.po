#: templates/base/labyrinthe_game.html:81
msgid ""
"\n"
"            Pour se déplacer, vous pouvez soit utilisez votre clavier : les "
"flèches de directions pour vous déplacer\n"
"            <b>rapidement</b> d'un bout à l'autre, et les touches Z, Q, S et "
"D pour vous déplacer <b>case par case</b> ;\n"
"            ou bien avec la souris en <b>cliquant d'abord</b> sur le joueur "
"puis en déplaçant la souris. Cliquez de nouveau\n"
"            sur le joueur pour arrêter le déplacement.\n"
"        "
msgstr ""

#: templates/base/labyrinthe_game.html:89
msgid ""
"\n"
"            Sur mobile (ou à la souris), utilisez le <b>pavé directionnel</"
"b> sous le terrain, ou touchez\n"
"            directement une <b>case voisine</b> du joueur pour vous y "
"déplacer.\n"
"        "
msgstr ""

